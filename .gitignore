# =============================================================================
# HBM-Meta-Agent — .gitignore
# 原则：**不入库原始研究数据与产出**（版权 + 体积 + 可复现性）
#       只入库 Skill 知识、脚本、模板、脱敏示例
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── 运行态产物：**状态目录不入库**（含快照登记与闸门状态）────────────
# 理由：_state/ 记录的是"某个使用者本地跑到哪一步"，属私有状态；
#       模板见 templates/，应以模板形式共享而非提交实例。
_state/

# ── 原始数据文件（★ 严禁入库）────────────────────────────────────────
# 文献提取表、统计软件数据、原始导出、PDF 全文
*.xlsx
*.xls
*.xlsm
*.sav
*.dta
*.csv
*.tsv
*.pdf
*.tif
*.tiff

# 例外：**脱敏示例与模板必须入库**（否则 CI 与使用者无法验证）
!templates/*.csv
!templates/*.yaml
!templates/*.yml
!examples/**/*.csv
!examples/**/*.yaml
!examples/**/*.yml
!examples/**/*.json
!examples/**/*.md

# ── 稿件与文献库产物 ─────────────────────────────────────────────────
*.docx
*.doc
*.pptx
*.ppt
*.enl
*.Data/
*.enlx
*.prism
*.htm
*.html

# ── 图形产物（源数据应可重建；成品图不入库）──────────────────────────
*.png
*.jpg
*.jpeg
*.svg

# ── 压缩包（投稿文件集常以 zip 交接）────────────────────────────────
*.zip
*.7z
*.rar

# ── 凭证与本地配置（★ 见 SKILL.md 红线：凭证不得进入任何交付物）────
.env
.env.*
*.pem
*.key
credentials*.json
*secret*
*password*
*账号*

# ── 编辑器与系统 ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── 临时目录 ─────────────────────────────────────────────────────────
_tmp/
tmp/
scratch/
*.tmp
*.bak
*~
